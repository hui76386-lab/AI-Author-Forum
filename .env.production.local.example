READER_VERIFICATION_WINDOW_SECONDS=3600
READER_VERIFICATION_CONSUME_LIMIT=5
READER_SECURITY_RETENTION_DAYS=30
READER_COMMENT_RISK_ENABLED=true
READER_COMMENT_RISK_TIMEOUT_SECONDS=1
READER_COMMENT_MAX_CHARS=2000
