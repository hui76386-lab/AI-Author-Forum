READER_DEVICE_FLOW_TTL_SECONDS=900
READER_DEVICE_FLOW_POLL_INTERVAL_SECONDS=5
READER_DEVICE_FLOW_ATTEMPT_LIMIT=5
READER_DEVICE_FLOW_STATUS_LIMIT=120
READER_DEVICE_FLOW_CLAIM_LIMIT=10
READER_DEVICE_FLOW_STATUS_WINDOW_SECONDS=60
READER_TRUST_PROXY_CLIENT_IP=true
READER_EMAIL_LOOKUP_KEY=replace-with-at-least-32-random-characters
