# Isolated local middleware profile; do not use for production.
# Run with:
# docker compose --env-file .env.production.local \
#   -f docker-compose.production.yml \
#   -f docker-compose.local-middleware.yml up -d --build
SECRET_KEY=replace-with-a-long-random-value
MIDDLEWARE_MODE=local
DATABASE_URL=postgresql://ai_author_forum:replace-with-a-strong-database-password@database:5432/ai_author_forum
INTERACTIONS_DATABASE_URL=postgresql://ai_author_forum:replace-with-a-strong-database-password@database:5432/ai_author_forum_interactions
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
POSTGRES_PASSWORD=replace-with-a-strong-database-password
INTERACTIONS_POSTGRES_DB=ai_author_forum_interactions
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=http://localhost
WAGTAILADMIN_BASE_URL=http://localhost
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
STATIC_PUBLISH_HEALTHCHECK_BROKER=true
READER_INTERACTIONS_ENABLED=false
READER_EMAIL_VERIFICATION_ENABLED=false
READER_COMMENTS_WRITE_ENABLED=false
READER_PDF_GRANTS_ENABLED=false
READER_SHARE_UI_ENABLED=false
READER_SNAPSHOT_READ_FALLBACK=false
