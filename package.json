    "sass": "^1.71.0",
    "sass-loader": "^14.1.1",
    "tailwindcss": "^3.4.19",
    "sucrase": "^3.35.1",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "devDependencies": {
