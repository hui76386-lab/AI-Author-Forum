# Production application settings. Keep this file outside version control or inject
# equivalent values through Docker secrets/CI. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-value
MIDDLEWARE_MODE=remote
DATABASE_URL=postgresql://ai_author_forum:replace-with-url-encoded-password@db.example.internal:5432/ai_author_forum
INTERACTIONS_DATABASE_URL=postgresql://ai_author_forum_interactions:replace-with-url-encoded-password@interactions-db.example.internal:5432/ai_author_forum_interactions
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=rediss://:replace-with-url-encoded-password@redis.example.internal:6380/1
CELERY_BROKER_URL=rediss://:replace-with-url-encoded-password@redis.example.internal:6380/0
CELERY_RESULT_BACKEND=rediss://:replace-with-url-encoded-password@redis.example.internal:6380/0
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com
WAGTAILADMIN_BASE_URL=https://example.com
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
STATIC_PUBLISH_HEALTHCHECK_BROKER=true
STATIC_PUBLISH_BROKER_HEALTHCHECK_TIMEOUT=2
READER_INTERACTIONS_ENABLED=false
READER_EMAIL_VERIFICATION_ENABLED=false
READER_COMMENTS_WRITE_ENABLED=false
READER_PDF_GRANTS_ENABLED=false
READER_SHARE_UI_ENABLED=false
READER_SNAPSHOT_READ_FALLBACK=false
READER_SESSION_ABSOLUTE_SECONDS=2592000
READER_SESSION_IDLE_SECONDS=1209600
READER_SESSION_TOUCH_INTERVAL_SECONDS=300
READER_SESSION_COOKIE_SECURE=true
READER_DEVICE_FLOW_COOKIE_SECURE=true
READER_DEVICE_FLOW_COOKIE_NAME=reader_device_flow
READER_DEVICE_FLOW_TTL_SECONDS=900
READER_DEVICE_FLOW_POLL_INTERVAL_SECONDS=5
READER_DEVICE_FLOW_ATTEMPT_LIMIT=5
READER_DEVICE_FLOW_STATUS_LIMIT=120
READER_DEVICE_FLOW_CLAIM_LIMIT=10
READER_DEVICE_FLOW_STATUS_WINDOW_SECONDS=60
READER_TRUST_PROXY_CLIENT_IP=true
READER_EMAIL_LOOKUP_KEY=replace-with-at-least-32-random-characters
READER_EMAIL_ENCRYPTION_KEYS=1:replace-with-a-urlsafe-base64-fernet-key
READER_TOKEN_PEPPER=replace-with-at-least-32-random-characters
READER_MAGIC_LINK_TTL_SECONDS=900
READER_PUBLIC_BASE_URL=https://example.com
READER_EMAIL_FROM=reader-security@example.com
READER_RATE_LIMIT_REDIS_URL=rediss://:replace-with-url-encoded-password@redis.example.internal:6380/1
READER_CAPABILITY_REDIS_URL=rediss://:replace-with-url-encoded-password@redis.example.internal:6380/1
READER_INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
READER_VERIFICATION_IP_LIMIT=5
READER_VERIFICATION_EMAIL_LIMIT=3
READER_VERIFICATION_GLOBAL_LIMIT=1000
READER_VERIFICATION_WINDOW_SECONDS=3600
READER_VERIFICATION_CONSUME_LIMIT=5
READER_SECURITY_RETENTION_DAYS=30
READER_COMMENT_RISK_ENABLED=true
READER_COMMENT_RISK_TIMEOUT_SECONDS=1
READER_COMMENT_MAX_CHARS=2000
READER_COMMENT_MAX_BYTES=8000
READER_COMMENT_PAGE_SIZE=20
READER_COMMENT_CACHE_SECONDS=30
READER_COMMENT_INTERVAL_SECONDS=10
READER_COMMENT_HOURLY_LIMIT=20
READER_COMMENT_DAILY_LIMIT=100
READER_COMMENT_ARTICLE_HOURLY_LIMIT=10
READER_COMMENT_IP_HOURLY_LIMIT=60
READER_REPORT_DAILY_LIMIT=20
READER_REPORT_IP_DAILY_LIMIT=100
READER_COMMENT_CACHE_REDIS_URL=rediss://:replace-with-url-encoded-password@redis.example.internal:6380/1
READER_COMMENT_SNAPSHOT_ROOT=/data/comment-snapshots
READER_PRIVATE_STORAGE_BACKEND=s3
READER_PRIVATE_STORAGE_ROOT=/data/protected-pdfs
READER_PDF_MAX_BYTES=104857600
READER_PDF_RENDER_TIMEOUT_SECONDS=60
READER_PDF_RENDERER_VERSION=playwright-python/1.61.0-chromium
READER_PDF_BUILD_WAIT_SECONDS=900
READER_PDF_BUILD_POLL_SECONDS=0.5
READER_DOWNLOAD_GRANT_TTL_SECONDS=300
READER_DOWNLOAD_ARTICLE_HOURLY_LIMIT=5
READER_DOWNLOAD_DAILY_LIMIT=50
READER_DOWNLOAD_IP_HOURLY_LIMIT=20
READER_PDF_GRANT_REDIS_URL=rediss://:replace-with-url-encoded-password@redis.example.internal:6380/1
READER_PDF_X_ACCEL_PREFIX=/_protected_pdf/
READER_S3_BUCKET=replace-with-private-reader-pdf-bucket
READER_S3_ENDPOINT_URL=https://object-storage.example.internal
READER_S3_REGION=replace-with-region
READER_S3_ACCESS_KEY_ID=replace-with-reader-pdf-access-key
READER_S3_SECRET_ACCESS_KEY=replace-with-reader-pdf-secret-key
READER_DATABASE_CONN_MAX_AGE=60
READER_DATABASE_STATEMENT_TIMEOUT_MS=5000
READER_INTERACTIONS_DB_CONNECTION_LIMIT=20
DEPLOYMENT_ENVIRONMENT=production
APPLICATION_RELEASE=replace-with-immutable-release-id
READER_API_REPLICAS=2
READER_API_GUNICORN_WORKERS=2
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.internal
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-provider-user
EMAIL_HOST_PASSWORD=replace-with-provider-secret
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
HTTP_PORT=8080
