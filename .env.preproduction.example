# Isolated server preproduction profile for article document-import acceptance.
# Copy this file to .env.preproduction on the server and replace every placeholder.
# Do not commit the copied file or any real credentials.
#
# Start command:
# docker compose --project-name ai-author-forum-doc-import-preprod --env-file .env.preproduction \
#   -f docker-compose.production.yml -f docker-compose.local-middleware.yml \
#   -f docker-compose.preproduction.yml up -d --build
SECRET_KEY=replace-with-a-long-random-value
MIDDLEWARE_MODE=local
DATABASE_URL=postgresql://ai_author_forum:replace-with-a-strong-database-password@database:5432/ai_author_forum
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
WAGTAILADMIN_BASE_URL=http://localhost
# The isolated benchmark stack uses plain HTTP only; do not reuse these values for production.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
STATIC_PUBLISH_HEALTHCHECK_BROKER=true
STATIC_PUBLISH_BROKER_HEALTHCHECK_TIMEOUT=2
HTTP_PORT=18080
