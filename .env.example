# Local development defaults. Replace all secrets before deployment.
DJANGO_SETTINGS_MODULE=ai_author_forum.settings.dev
SECRET_KEY=change-me-in-development
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=sqlite:///db.sqlite3
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=ai-author-forum
MEDIA_ROOT=media
STATIC_ROOT=static
STATIC_PUBLISH_ROOT=published
STATIC_PUBLISH_HEALTHCHECK_BROKER=false
STATIC_PUBLISH_BROKER_HEALTHCHECK_TIMEOUT=2
# If your local Redis has requirepass enabled, use:
# redis://:url-encoded-password@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WAGTAILADMIN_BASE_URL=http://localhost:8000
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
